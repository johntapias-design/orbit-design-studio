{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.local/schemas/orbit-json-v13.schema.json",
  "title": "Orbit JSON v13 — AI authoring contract & Component Auto-Promotion",
  "description": "Contrato estricto versión 13 para la generación e importación de diseño visual, clases globales compartidas y auto-promoción de componentes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "projectName",
    "pageMeta",
    "tokens",
    "assets",
    "components",
    "globalClasses",
    "nodes"
  ],
  "properties": {
    "version": {
      "const": 13
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "pageMeta": {
      "$ref": "#/$defs/pageMeta"
    },
    "tokens": {
      "$ref": "#/$defs/tokens"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "globalClasses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/globalClass"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "pageMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "title", "description"],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 12
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "maxLength": 180
        },
        "ogImage": {
          "type": "string"
        },
        "noIndex": {
          "type": "boolean"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "cssVar": {
          "type": "string"
        }
      }
    },
    "tokenGroup": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/token"
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "typography", "spacing", "radius", "shadows"],
      "properties": {
        "colors": { "$ref": "#/$defs/tokenGroup" },
        "typography": { "$ref": "#/$defs/tokenGroup" },
        "spacing": { "$ref": "#/$defs/tokenGroup" },
        "radius": { "$ref": "#/$defs/tokenGroup" },
        "shadows": { "$ref": "#/$defs/tokenGroup" }
      }
    },
    "styleDeclarations": {
      "type": "object",
      "propertyNames": {
        "enum": ["width", "maxWidth", "minWidth", "height", "maxHeight", "minHeight", "aspectRatio", "boxSizing", "paddingTop", "paddingRight", "paddingBottom", "paddingLeft", "marginTop", "marginRight", "marginBottom", "marginLeft", "gap", "columnGap", "rowGap", "display", "direction", "flexWrap", "justifyContent", "justify", "alignItems", "align", "justifyItems", "alignContent", "gridColumns", "gridRows", "gridTemplateColumns", "gridTemplateRows", "gridTemplateAreas", "gridArea", "gridColumn", "gridRow", "gridAutoColumns", "gridAutoRows", "gridAutoFlow", "gridUseMinMax", "gridColumnTracks", "gridRowTracks", "order", "verticalAlign", "alignSelf", "justifySelf", "flexGrow", "flexShrink", "flexBasis", "position", "zIndex", "left", "top", "right", "bottom", "transform", "transition", "cursor", "pointerEvents", "background", "color", "fontFamily", "fontSize", "fontWeight", "lineHeight", "letterSpacing", "textAlign", "fontStyle", "textTransform", "textDecoration", "textShadow", "fontVariationSettings", "whiteSpace", "textWrap", "borderRadius", "borderWidth", "borderColor", "opacity", "boxShadow", "objectFit", "overflow"]
      },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "responsiveStyles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": { "$ref": "#/$defs/styleDeclarations" },
        "desktopXL": { "$ref": "#/$defs/styleDeclarations" },
        "desktop": { "$ref": "#/$defs/styleDeclarations" },
        "tablet": { "$ref": "#/$defs/styleDeclarations" },
        "mobileL": { "$ref": "#/$defs/styleDeclarations" },
        "mobile": { "$ref": "#/$defs/styleDeclarations" }
      }
    },
    "interactionStates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hover": { "$ref": "#/$defs/styleDeclarations" },
        "focus": { "$ref": "#/$defs/styleDeclarations" },
        "active": { "$ref": "#/$defs/styleDeclarations" },
        "disabled": { "$ref": "#/$defs/styleDeclarations" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "src"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "svg", "icon"] },
        "src": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "masterId"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "masterId": { "type": "string" },
        "instances": { "type": "integer", "minimum": 0 },
        "variants": {
          "type": "array",
          "items": { "type": "object" }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "type"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["text", "image", "url", "boolean"] },
              "defaultValue": { "type": "string" }
            }
          }
        },
        "overrides": { "type": "integer", "minimum": 0 }
      }
    },
    "globalClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "styles"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "styles": { "$ref": "#/$defs/responsiveStyles" },
        "states": { "$ref": "#/$defs/interactionStates" },
        "backgroundConfig": { "type": "object" }
      }
    },
    "backgroundConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["none", "color", "image", "gradient"] },
        "color": { "type": "string" },
        "image": { "type": "string" },
        "size": { "type": "string" },
        "position": { "type": "string" },
        "gradientType": { "type": "string", "enum": ["linear", "radial"] },
        "angle": { "type": "integer" },
        "gradientStops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["color", "position"],
            "properties": {
              "color": { "type": "string" },
              "position": { "type": "integer" }
            }
          }
        },
        "overlayColor": { "type": "string" },
        "overlayOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "swiper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slidesPerView": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "desktopXL": { "type": "number", "minimum": 1, "maximum": 8 },
            "desktop": { "type": "number", "minimum": 1, "maximum": 8 },
            "tablet": { "type": "number", "minimum": 1, "maximum": 8 },
            "mobileL": { "type": "number", "minimum": 1, "maximum": 8 },
            "mobile": { "type": "number", "minimum": 1, "maximum": 8 }
          }
        },
        "spaceBetween": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "desktopXL": { "type": "number", "minimum": 0, "maximum": 120 },
            "desktop": { "type": "number", "minimum": 0, "maximum": 120 },
            "tablet": { "type": "number", "minimum": 0, "maximum": 120 },
            "mobileL": { "type": "number", "minimum": 0, "maximum": 120 },
            "mobile": { "type": "number", "minimum": 0, "maximum": 120 }
          }
        },
        "speed": { "type": "integer", "minimum": 100, "maximum": 3000 },
        "effect": { "type": "string", "enum": ["slide", "fade"] },
        "direction": { "type": "string", "enum": ["horizontal", "vertical"] },
        "loop": { "type": "boolean" },
        "centered": { "type": "boolean" },
        "navigation": { "type": "boolean" },
        "pagination": { "type": "boolean" },
        "keyboard": { "type": "boolean" },
        "autoplay": { "type": "boolean" },
        "autoplayDelay": { "type": "integer", "minimum": 800, "maximum": 20000 },
        "pauseOnMouseEnter": { "type": "boolean" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["section", "container", "heading", "text", "button", "image", "svg", "card", "carousel", "slide", "divider", "spacer"]
        },
        "name": { "type": "string" },
        "content": { "type": "string" },
        "src": { "type": "string" },
        "alt": { "type": "string" },
        "href": { "type": "string" },
        "svgCode": { "type": "string" },
        "ariaLabel": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "globalClassIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "styleClassId": { "type": "string" },
        "styleEditMode": { "type": "string", "enum": ["shared", "local"] },
        "componentRef": { "type": "string" },
        "componentSource": { "type": "string", "enum": ["master", "instance"] },
        "styles": { "$ref": "#/$defs/responsiveStyles" },
        "states": { "$ref": "#/$defs/interactionStates" },
        "backgroundConfig": { "$ref": "#/$defs/backgroundConfig" },
        "swiper": { "$ref": "#/$defs/swiper" },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
